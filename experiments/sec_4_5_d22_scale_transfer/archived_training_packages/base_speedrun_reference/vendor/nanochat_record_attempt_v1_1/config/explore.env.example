# Paths
REPO="$HOME/nanochat-record"
# Shared persistent directory. Do not point this at node-local scratch.
NANOCHAT_BASE_DIR="$HOME/nanochat-data-record"
# Package directory after extraction.
RECORD_PACKAGE_DIR="$HOME/nanochat_record_attempt_v1"

# Optional node-local directory for snapshots. Leave blank to use $LOCAL/$SLURM_TMPDIR.
RECORD_LOCAL_ROOT=""

# The PR #830 recipe and our frozen D12-derived intervention.
DEPTH=22
TRAIN_RATIO=9.4
SCHEDULE_RATIO=9.4
SNAPSHOT_RATIOS="9.0,9.1,9.2,9.3,9.4"
TERMINAL_CLAMP_FRAC=0.15
SNAPSHOT_K=8
SNAPSHOT_SPACING_FRAC=0.010666666666666666
RECIPES_FILE="$RECORD_PACKAGE_DIR/config/recipes_compact.txt"

# Evaluation policy. Quick BPB ranks candidates; full CORE is a separate ladder.
SCREEN_SPLIT_TOKENS=4194304
CANONICAL_SPLIT_TOKENS=20971520
CORE_THRESHOLD=0.256525
CORE_SAFETY_MARGIN=0.0015

# Optional wandb name. "dummy" disables wandb.
WANDB_RUN="dummy"
RUN_TAG="record_explore_$(date +%Y%m%d_%H%M%S)"
